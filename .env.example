# Copy to .env and fill in real values. Never commit .env (SECURITY_COMPLIANCE.md §1).

# --- safety ---
DRY_RUN=true                     # true = no uploads/public posts
FACTORY_CHANNEL=coil-and-cog     # default channel slug

# --- LLM ---
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Google ---
YOUTUBE_API_KEY=                 # read-only public data for discover (no OAuth needed)
# YouTube sign-in needs no setting here: secrets/<slug>/google_client_secret.json (task 0.4)
# and secrets/<slug>/google_token.json (written by `factory auth youtube`, D-102)

# --- TikTok ---
# Not used: TikTok doesn't approve API apps for personal use, so posting stays manual (D-116)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_TOKEN_FILE=secrets/coil-and-cog/tiktok_token.json

# --- Wikimedia ---
WIKIMEDIA_USER_AGENT=CoilAndCogFactory/0.1 (contact: CHANNEL_EMAIL_HERE)
